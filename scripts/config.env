# Edit these before running the scripts.
# REGISTRY_NAME must be globally unique across DigitalOcean (e.g. add your initials).
export REGISTRY_NAME="pooja-doks-demo-2026"
export CLUSTER_NAME="web-app-cluster"
export REGION="sfo3"                 # San Francisco; run `doctl kubernetes options regions` for others
export NODE_SIZE="s-2vcpu-4gb"       # 2 vCPU / 4 GiB Basic Droplet, $24/month each
export NODE_POOL="web-pool"
export MIN_NODES=2                   # availability design; verify actual pod placement and failover
export MAX_NODES=4                   # bounds this node pool, not the total account bill
export IMAGE_NAME="web-app"
export IMAGE_TAG="1.0.2"
export KUBERNETES_VERSION="1.37.0-do.2" # observed on the demo cluster; check availability before new creation
